# Copy to terraform.tfvars and adjust as needed.

aws_region   = "eu-central-1"
project_name = "devops-assignment"
environment  = "dev"

availability_zones    = ["eu-central-1a", "eu-central-1b"]
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
database_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]

container_port     = 8080
health_check_path  = "/health" # matches GET /health in app/api/app.py
# Pinned placeholders, not real app images. Point these at the ECR repo
# outputs (ecr_api_repository_url / ecr_worker_repository_url) with your
# own version tag once you've built and pushed real images.
api_image            = "124355677006.dkr.ecr.eu-central-1.amazonaws.com/devops-assignment-dev-api:v0.1.0"
worker_image         = "124355677006.dkr.ecr.eu-central-1.amazonaws.com/devops-assignment-dev-worker:v0.1.0"
api_desired_count    = 2
worker_desired_count = 1

db_instance_class = "db.t3.micro"
db_name           = "appdb"
db_username       = "app_admin"
